/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running stub tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Uses stub mode for fast testing without running actual tools.
    Validates workflow logic and channel connections.

    Use as follows:
        nextflow run nf-core/kra -profile test_stub -stub --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Stub test profile'
    config_profile_description = 'Stub test configuration for workflow validation'

    // Limit resources
    max_cpus   = 1
    max_memory = '2.GB'
    max_time   = '1.h'

    // Test data - using stub test data in assets/test_data
    fasta     = "${projectDir}/assets/test_data/test_sequences.fasta"
    hmm       = "${projectDir}/assets/test_data/test.hmm"
    resources = "${projectDir}/assets/test_data/resources"

    // Minimal parameters
    threads             = 1
    cpu_cores_iprscan   = 1
    seq_batch_size      = 5
}

// Enable stub mode
stubRun = true
