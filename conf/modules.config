/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
        publishDir = List of maps defining publishDir rules.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // HMMSEARCH output goes to root of results
    withName: HMMSEARCH {
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            pattern: "hmmsearch_*.{json,txt}"
        ]
    }

    // SEQ_BATCH_PREP outputs
    withName: SEQ_BATCH_PREP {
        publishDir = [
            [
                path: { "${params.outdir}" },
                mode: params.publish_dir_mode,
                pattern: "all_sequences.json"
            ],
            [
                path: { "${params.outdir}/batches" },
                mode: params.publish_dir_mode,
                pattern: "batches/*"
            ]
        ]
    }

    // RUN_IPRSCAN outputs to batches folder
    withName: RUN_IPRSCAN {
        publishDir = [
            path: { "${params.outdir}/batches" },
            mode: params.publish_dir_mode,
            pattern: "*.tsv"
        ]
    }

    // PREPARE_FASTA outputs domain directories
    withName: PREPARE_FASTA {
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            pattern: "PF*/**"
        ]
    }

    // HMMALIGN outputs aligned files within domain directories
    withName: HMMALIGN {
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            pattern: "PF*/*_hmmalign.sth"
        ]
    }

    // TRANSFER_ANNOTATIONS outputs domain reports
    withName: TRANSFER_ANNOTATIONS {
        // The process emits whole domain directories, so the pattern names the directory;
        // by this step it holds domain_info.json, the hits FASTA, the alignment and the report.
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            pattern: "PF*"
        ]
    }

    // MERGE_REPORTS outputs sequence-level reports
    withName: MERGE_REPORTS {
        // Not published: MAKE_VIEW_JSONS publishes the same sequence directories in their
        // final state, and publishing both could let the earlier copy overwrite the later.
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            pattern: "*/**",
            enabled: false
        ]
    }

    // MAKE_VIEW_JSONS outputs final view JSONs
    withName: MAKE_VIEW_JSONS {
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            pattern: "sequences/*"
        ]
    }

}
