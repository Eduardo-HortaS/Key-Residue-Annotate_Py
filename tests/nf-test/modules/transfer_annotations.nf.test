nextflow_process {

    name "Test Process TRANSFER_ANNOTATIONS"
    script "modules/local/transfer_annotations.nf"
    process "TRANSFER_ANNOTATIONS"

    test("Should produce domain reports and sequence dirs in stub mode") {

        options "-stub"

        setup {
            run("PREPARE_FASTA", alias: "SETUP_PREPARE") {
                script "modules/local/prepare_fasta.nf"
                process {
                    """
                    input[0] = file("${projectDir}/assets/test_data/test_hmmsearch_per_domain.json")
                    input[1] = file("${projectDir}/assets/test_data/test_sequences.fasta")
                    input[2] = file("${projectDir}/assets/test_data/resources")
                    """
                }
            }
            run("HMMALIGN", alias: "SETUP_ALIGN") {
                script "modules/local/hmmalign.nf"
                process {
                    """
                    input[0] = SETUP_PREPARE.out.domain_dirs.flatten().first()
                    input[1] = file("${projectDir}/assets/test_data/resources")
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = SETUP_ALIGN.out.aligned_domains.flatten().first()
                input[1] = file("${projectDir}/assets/test_data/resources")
                input[2] = []
                """
            }
        }

        then {
            assert process.success
            assert process.out.domain_reports
            assert process.out.sequence_dirs
            assert process.out.versions
        }

    }

}
